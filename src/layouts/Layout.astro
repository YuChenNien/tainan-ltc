---
import '../styles/global.css';
import Ico from '../components/Ico.astro';
import { url } from '../lib/data';
interface Props { title: string; description?: string; }
const { title, description = '整理台南市政府公開資料，查詢並比較住宿式長照機構的評鑑、床位與收費上限。' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}｜台南長照住宿機構查詢</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <div class="preview-bar">預覽版：目前為版面與資料展示，比較、試算功能陸續完成中</div>
    <header class="site-header">
      <div class="wrap header-in">
        <a class="brand" href={url('/')}><Ico name="home" size={26} /><span>台南長照住宿機構查詢</span></a>
        <nav aria-label="主選單">
          <a href={url('/styleguide/')}><Ico name="info" size={20} />版面與圖示</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>資料來源</strong>：臺南市政府社會局、臺南市政府衛生局公開資料。每家機構頁會標示各欄位的來源與更新日期。</p>
        <p>本站為民間整理，非政府網站。評鑑、床位、收費資料以主管機關與機構公告為準；收費僅有官方「上限」，實際費用請洽機構報價。</p>
      </div>
    </footer>
  </body>
</html>
