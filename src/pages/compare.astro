---
import Layout from '../layouts/Layout.astro';
import Ico from '../components/Ico.astro';
import { insts, typeOf, serviceTags, gradeInfo, bedsText, ownership, manual, FEES, url } from '../lib/data';

const rooms = Object.entries(FEES.long_term_monthly) as [string, number][];
const data = insts.map((i) => {
  const g = gradeInfo(i);
  const m = manual[i.id] || {};
  return {
    id: i.id, name: i.name, href: url(`/institutions/${i.id}/`),
    type: typeOf(i).short, tags: serviceTags(i).join('、') || '—',
    own: ownership(i) === '待確認' ? '待確認（名稱看不出）' : ownership(i) + '（依名稱判斷）',
    district: i.district, address: i.address, phone: i.phone,
    beds: bedsText(i), target: i.target || '—',
    grade: g.text + (g.year ? `（${g.year}）` : ''),
    fees: rooms.map(([, v]) => (i.src === 'A' ? '待確認' : `${v.toLocaleString('zh-Hant')} 元`)),
    website: m.website || '尚未收錄', fanpage: m.fanpage || '尚未收錄',
    source: `${i.source_name}（${i.source_date}）`,
  };
});
const roomNames = rooms.map(([k]) => k);
---
<Layout title="比較機構">
  <div class="wrap" id="compare-root">
    <div class="page-head">
      <h1>比較機構</h1>
      <p class="note">在首頁或機構頁勾選「加入比較」，最多 4 家。收費只列官方公告的「上限」，不是實際價格，實際以機構報價為準。</p>
    </div>

    <p id="cmp-empty" class="empty" hidden>
      目前選的機構不足 2 家。請回<a href={url('/')}>首頁</a>勾選「加入比較」。
    </p>

    <div id="cmp-main" hidden>
      <div class="cmp-tools">
        <label class="opt-inline"><input type="checkbox" id="diff-only" />只看有差異的項目</label>
        <button type="button" class="btn-line" id="btn-xlsx"><Ico name="file" size={20} />匯出 Excel</button>
        <button type="button" class="btn-line" id="btn-print"><Ico name="file" size={20} />列印／存成 PDF</button>
        <button type="button" class="btn-line" id="btn-clear">清除全部</button>
      </div>
      <div class="cmp-scroll"><table class="cmp-table" id="cmp-table"></table></div>
      <p class="disclaimer print-keep"><Ico name="warn" size={20} />收費僅供參考，實際以機構報價為準。資料來源為臺南市政府社會局、衛生局公開資料。</p>
      <p class="hint" id="cmp-time"></p>
    </div>
  </div>

  <script type="application/json" id="cmp-data" set:html={JSON.stringify({ data, roomNames })}></script>
</Layout>

<script>
  const { data, roomNames } = JSON.parse(document.getElementById('cmp-data')!.textContent!);
  const byId: Record<string, any> = Object.fromEntries(data.map((d: any) => [d.id, d]));
  const T = (window as any).tnCmp;
  const rows: [string, (d: any) => string][] = [
    ['單位類型', (d) => d.type], ['服務類型', (d) => d.tags], ['經營型態', (d) => d.own],
    ['行政區', (d) => d.district], ['地址', (d) => d.address], ['電話', (d) => d.phone],
    ['床位', (d) => d.beds], ['收住對象', (d) => d.target], ['政府評鑑（等第與年度）', (d) => d.grade],
    ...roomNames.map((n: string, k: number): [string, (d: any) => string] => ['月費上限：' + n, (d) => d.fees[k]]),
    ['官方網站', (d) => d.website], ['粉絲專頁', (d) => d.fanpage], ['資料來源與日期', (d) => d.source],
  ];

  function currentIds(): string[] {
    const p = new URLSearchParams(location.search).get('ids');
    const ids = (p ? p.split(',') : T.load()).filter((x: string) => byId[x]).slice(0, T.MAX);
    return [...new Set(ids)] as string[];
  }
  let ids = currentIds();
  if (new URLSearchParams(location.search).get('ids')) T.save(ids);

  function render() {
    T.sync();
    const ok = ids.length >= 2;
    document.getElementById('cmp-empty')!.hidden = ok;
    document.getElementById('cmp-main')!.hidden = !ok;
    history.replaceState(null, '', location.pathname + (ids.length ? '?ids=' + ids.join(',') : ''));
    if (!ok) return;
    const diffOnly = (document.getElementById('diff-only') as HTMLInputElement).checked;
    const list = ids.map((i) => byId[i]);
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
    let html = '<thead><tr><th scope="col">項目</th>' + list.map((d) =>
      `<th scope="col"><a href="${d.href}">${esc(d.name)}</a><br><button type="button" class="rm" data-id="${d.id}">移除</button></th>`).join('') + '</tr></thead><tbody>';
    for (const [label, f] of rows) {
      const vals = list.map(f);
      const same = vals.every((v) => v === vals[0]);
      if (diffOnly && same) continue;
      html += `<tr class="${same ? '' : 'diff'}"><th scope="row">${esc(label)}</th>` + vals.map((v) => `<td>${esc(v)}</td>`).join('') + '</tr>';
    }
    document.getElementById('cmp-table')!.innerHTML = html + '</tbody>';
    document.getElementById('cmp-time')!.textContent = '產生日期：' + new Date().toLocaleDateString('zh-TW') + '　淡黃底色的列＝各機構不同。';
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.rm') as HTMLElement | null;
    if (b) { ids = ids.filter((x) => x !== b.dataset.id); T.save(ids); render(); }
  });
  document.getElementById('diff-only')!.addEventListener('change', render);
  document.getElementById('btn-clear')!.addEventListener('click', () => { ids = []; T.save([]); render(); });
  document.addEventListener('cmp-cleared', () => { ids = []; render(); });
  document.getElementById('btn-print')!.addEventListener('click', () => window.print());

  // ---------- 匯出 Excel（自己組一個最小的 .xlsx，不用額外套件）----------
  const enc = new TextEncoder();
  const crcT = (() => { const t: number[] = []; for (let n = 0; n < 256; n++) { let c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; t[n] = c >>> 0; } return t; })();
  const crc32 = (b: Uint8Array) => { let c = 0xffffffff; for (const x of b) c = crcT[(c ^ x) & 255] ^ (c >>> 8); return (c ^ 0xffffffff) >>> 0; };
  function zip(files: [string, string][]): Blob {
    const parts: Uint8Array[] = [], central: Uint8Array[] = []; let off = 0;
    for (const [name, text] of files) {
      const nb = enc.encode(name), db = enc.encode(text), crc = crc32(db);
      const h = new DataView(new ArrayBuffer(30)); h.setUint32(0, 0x04034b50, true); h.setUint16(4, 20, true); h.setUint16(6, 0x0800, true);
      h.setUint32(14, crc, true); h.setUint32(18, db.length, true); h.setUint32(22, db.length, true); h.setUint16(26, nb.length, true);
      parts.push(new Uint8Array(h.buffer), nb, db);
      const c = new DataView(new ArrayBuffer(46)); c.setUint32(0, 0x02014b50, true); c.setUint16(4, 20, true); c.setUint16(6, 20, true); c.setUint16(8, 0x0800, true);
      c.setUint32(16, crc, true); c.setUint32(20, db.length, true); c.setUint32(24, db.length, true); c.setUint16(28, nb.length, true); c.setUint32(42, off, true);
      central.push(new Uint8Array(c.buffer), nb);
      off += 30 + nb.length + db.length;
    }
    const csz = central.reduce((a, b) => a + b.length, 0);
    const e = new DataView(new ArrayBuffer(22)); e.setUint32(0, 0x06054b50, true); e.setUint16(8, files.length, true); e.setUint16(10, files.length, true); e.setUint32(12, csz, true); e.setUint32(16, off, true);
    return new Blob([...parts, ...central, new Uint8Array(e.buffer)] as BlobPart[], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  }
  const xe = (s: string) => s.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f]/g, '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as any)[c]);
  document.getElementById('btn-xlsx')!.addEventListener('click', () => {
    const list = ids.map((i) => byId[i]);
    const grid: string[][] = [['項目', ...list.map((d) => d.name)], ...rows.map(([l, f]) => [l, ...list.map(f)] as string[]),
      [], ['備註', '收費僅供參考，實際以機構報價為準。資料來源：臺南市政府社會局、衛生局公開資料。匯出日期 ' + new Date().toLocaleDateString('zh-TW')]];
    const col = (n: number) => String.fromCharCode(65 + n);
    const sheet = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?><worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><cols><col min="1" max="1" width="26" customWidth="1"/><col min="2" max="' + (list.length + 1) + '" width="38" customWidth="1"/></cols><sheetData>' +
      grid.map((r, ri) => `<row r="${ri + 1}">` + r.map((v, ci) => `<c r="${col(ci)}${ri + 1}" t="inlineStr" s="${ri === 0 || ci === 0 ? 2 : 1}"><is><t xml:space="preserve">${xe(v)}</t></is></c>`).join('') + '</row>').join('') + '</sheetData></worksheet>';
    const files: [string, string][] = [
      ['[Content_Types].xml', '<?xml version="1.0" encoding="UTF-8"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/><Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/><Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/></Types>'],
      ['_rels/.rels', '<?xml version="1.0" encoding="UTF-8"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>'],
      ['xl/workbook.xml', '<?xml version="1.0" encoding="UTF-8"?><workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets><sheet name="機構比較" sheetId="1" r:id="rId1"/></sheets></workbook>'],
      ['xl/_rels/workbook.xml.rels', '<?xml version="1.0" encoding="UTF-8"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/></Relationships>'],
      ['xl/styles.xml', '<?xml version="1.0" encoding="UTF-8"?><styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><fonts count="2"><font><sz val="11"/><name val="Microsoft JhengHei"/></font><font><b/><sz val="11"/><name val="Microsoft JhengHei"/></font></fonts><fills count="2"><fill><patternFill patternType="none"/></fill><fill><patternFill patternType="gray125"/></fill></fills><borders count="1"><border><left/><right/><top/><bottom/><diagonal/></border></borders><cellStyleXfs count="1"><xf numFmtId="0" fontId="0" fillId="0" borderId="0"/></cellStyleXfs><cellXfs count="3"><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0"/><xf numFmtId="0" fontId="0" fillId="0" borderId="0" xfId="0" applyAlignment="1"><alignment vertical="top" wrapText="1"/></xf><xf numFmtId="0" fontId="1" fillId="0" borderId="0" xfId="0" applyFont="1" applyAlignment="1"><alignment vertical="top" wrapText="1"/></xf></cellXfs></styleSheet>'],
      ['xl/worksheets/sheet1.xml', sheet],
    ];
    const a = document.createElement('a');
    a.href = URL.createObjectURL(zip(files)); a.download = '長照機構比較.xlsx';
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  });
  render();
</script>
