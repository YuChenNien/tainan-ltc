---
import Layout from '../layouts/Layout.astro';
import Ico from '../components/Ico.astro';
import InstCard from '../components/InstCard.astro';
import { TYPES, NEEDS, OWNS, insts, districts, sortByGrade, gradeInfo, serviceTags, ownership } from '../lib/data';

const groups = TYPES.map((t) => ({ t, list: sortByGrade(insts.filter((i) => i.category === t.key)) }));
function bands(list) {
  const out: { title: string; tone: string; items: typeof list }[] = [];
  for (const i of list) {
    const g = gradeInfo(i);
    const last = out[out.length - 1];
    if (last && last.title === g.text) last.items.push(i);
    else out.push({ title: g.text, tone: g.tone, items: [i] });
  }
  return out;
}
---
<Layout title="找機構">
  <div class="wrap">
    <div class="page-head">
      <h1>找機構</h1>
    </div>

    <form class="filter-bar" id="filterbar" role="search" onsubmit="return false">
      <div class="field">
        <label for="q">機構名稱或地址</label>
        <input id="q" type="search" placeholder="例如：仁德、慈愛" autocomplete="off" />
      </div>
      <div class="field">
        <label for="district">行政區</label>
        <select id="district">
          <option value="">全部地區</option>
          {districts.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
      <div class="field">
        <span class="lbl">需求與類型</span>
        <button type="button" class="btn-line" id="open-filter"><Ico name="search" size={20} />選擇需求條件<span id="badge" class="badge" hidden></span></button>
      </div>
    </form>

    <div class="result-bar" aria-live="polite">
      <p id="summary"><strong id="total">{insts.length}</strong> 家機構（未篩選＝全部）</p>
      <button type="button" class="btn-line" id="clear-all" hidden>清除全部條件</button>
    </div>
    <p id="active" class="note" hidden></p>

    <div class="jump" aria-label="跳到單位類型">
      {groups.map(({ t, list }) => (
        <a class={t.cls} href={`#${t.cls}`}><Ico name={t.icon} size={20} />{t.short}（<span data-jump={t.key}>{list.length}</span>）</a>
      ))}
    </div>
    <p class="note">
      <strong>排列方式：</strong>先依「單位類型」分三區；每區內依評鑑等第由好到差排列，同等第內評鑑年度較新的排前面。
      不同單位類型的評鑑制度不同，不能直接比高低，所以不混在一起排。
    </p>

    <p id="empty" class="empty" hidden>沒有符合的機構。請減少條件，或把行政區改成「全部地區」。</p>

    {groups.map(({ t, list }) => (
      <section id={t.cls} class={t.cls} data-group={t.key}>
        <div class="group-head"><Ico name={t.icon} size={30} /><h2>{t.short}（<span data-gcount>{list.length}</span> 家）</h2></div>
        <p class="group-desc">{t.desc}</p>
        {bands(list).map((b) => (
          <div data-band>
            <h3 class="subhead"><span class={`grade tone-${b.tone}`}><strong>{b.title}</strong></span>共 <span data-bcount>{b.items.length}</span> 家</h3>
            <div class="card-grid">
              {b.items.map((i) => (
                <div class="cw" data-type={i.category} data-tags={serviceTags(i).join(' ')} data-own={ownership(i)}
                  data-district={i.district} data-text={`${i.name} ${i.address}`}>
                  <InstCard inst={i} />
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>

  <dialog id="needdlg" aria-labelledby="dlg-title">
    <form method="dialog" id="needform">
      <div class="dlg-head"><h2 id="dlg-title">需求條件</h2><button type="button" class="x" id="dlg-x" aria-label="關閉"><Ico name="bad" size={28} /></button></div>
      <div class="dlg-body">
        <p class="hint">什麼都不勾＝查全部機構。同一組內勾多個＝符合任一個即可；不同組之間＝要同時符合。</p>
        <fieldset>
          <legend>服務類型</legend>
          {NEEDS.map((n) => (
            <label class="opt"><input type="checkbox" name="need" value={n.key} /><span><Ico name={n.icon} size={22} /><strong>{n.key}</strong><small>{n.hint}</small></span></label>
          ))}
        </fieldset>
        <fieldset>
          <legend>單位類型</legend>
          {TYPES.map((t) => (
            <label class="opt"><input type="checkbox" name="type" value={t.key} /><span><Ico name={t.icon} size={22} /><strong>{t.short}</strong></span></label>
          ))}
          <p class="hint">榮民之家：目前沒有官方名冊可用，暫未收錄。</p>
        </fieldset>
        <fieldset>
          <legend>更多條件：經營型態</legend>
          {OWNS.map((o) => (
            <label class="opt"><input type="checkbox" name="own" value={o} /><span><strong>{o}</strong></span></label>
          ))}
          <p class="hint">官方名冊沒有這個欄位，本站依機構名稱判斷（例如名稱有「私立」、「委託…經營」）。名稱看不出來的標為待確認，勾選時不會出現，請留意。</p>
        </fieldset>
      </div>
      <div class="dlg-foot">
        <button type="button" class="btn-line" id="dlg-clear">清除全部</button>
        <button type="button" class="btn" id="dlg-ok">確定（共 <span id="dlg-count">{insts.length}</span> 家）</button>
      </div>
    </form>
  </dialog>
</Layout>

<script>
  type St = { q: string; district: string; need: string[]; type: string[]; own: string[] };
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const cards = [...document.querySelectorAll<HTMLElement>('.cw')];
  const dlg = $('#needdlg') as HTMLDialogElement;
  const boxes = [...dlg.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
  const qEl = $('#q') as HTMLInputElement, dEl = $('#district') as HTMLSelectElement;

  const p = new URLSearchParams(location.search);
  let applied: St = { q: p.get('q') || '', district: p.get('district') || '', need: p.getAll('need'), type: p.getAll('type'), own: p.getAll('own') };

  const match = (c: HTMLElement, s: St) =>
    (!s.q || (c.dataset.text || '').includes(s.q.trim())) &&
    (!s.district || c.dataset.district === s.district) &&
    (!s.need.length || s.need.some((n) => (c.dataset.tags || '').split(' ').includes(n))) &&
    (!s.type.length || s.type.includes(c.dataset.type || '')) &&
    (!s.own.length || s.own.includes(c.dataset.own || ''));

  const readBoxes = () => ({
    need: boxes.filter((b) => b.name === 'need' && b.checked).map((b) => b.value),
    type: boxes.filter((b) => b.name === 'type' && b.checked).map((b) => b.value),
    own: boxes.filter((b) => b.name === 'own' && b.checked).map((b) => b.value),
  });
  const setBoxes = (s: St) => boxes.forEach((b) => (b.checked = (s as any)[b.name].includes(b.value)));
  const draft = (): St => ({ ...applied, ...readBoxes() });

  function render() {
    let total = 0;
    cards.forEach((c) => { const ok = match(c, applied); c.hidden = !ok; if (ok) total++; });
    document.querySelectorAll<HTMLElement>('[data-band]').forEach((b) => {
      const n = b.querySelectorAll('.cw:not([hidden])').length;
      b.hidden = n === 0; (b.querySelector('[data-bcount]') as HTMLElement).textContent = String(n);
    });
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
      const n = g.querySelectorAll('.cw:not([hidden])').length;
      g.hidden = n === 0; (g.querySelector('[data-gcount]') as HTMLElement).textContent = String(n);
      const j = document.querySelector(`[data-jump="${g.dataset.group}"]`); if (j) j.textContent = String(n);
    });
    const parts = [...applied.need, ...applied.type, ...applied.own];
    if (applied.district) parts.unshift(applied.district);
    if (applied.q) parts.unshift(`「${applied.q}」`);
    const filtered = parts.length > 0;
    $('#total').textContent = String(total);
    $('#summary').lastChild!.textContent = filtered ? ' 家符合條件的機構' : ' 家機構（未篩選＝全部）';
    const act = $('#active'); act.hidden = !filtered; act.textContent = '目前條件：' + parts.join('、');
    $('#clear-all').hidden = !filtered;
    const nb = applied.need.length + applied.type.length + applied.own.length;
    const badge = $('#badge'); badge.hidden = nb === 0; badge.textContent = String(nb);
    $('#empty').hidden = total !== 0;
    const u = new URLSearchParams();
    if (applied.q) u.set('q', applied.q);
    if (applied.district) u.set('district', applied.district);
    (['need', 'type', 'own'] as const).forEach((k) => applied[k].forEach((v) => u.append(k, v)));
    history.replaceState(null, '', location.pathname + (u.toString() ? '?' + u : '') + location.hash);
  }
  const liveCount = () => { const s = draft(); $('#dlg-count').textContent = String(cards.filter((c) => match(c, s)).length); };

  qEl.value = applied.q; dEl.value = applied.district; setBoxes(applied);
  qEl.addEventListener('input', () => { applied.q = qEl.value; render(); });
  dEl.addEventListener('change', () => { applied.district = dEl.value; render(); });
  $('#open-filter').addEventListener('click', () => { setBoxes(applied); liveCount(); dlg.showModal(); });
  boxes.forEach((b) => b.addEventListener('change', liveCount));
  $('#dlg-clear').addEventListener('click', () => { boxes.forEach((b) => (b.checked = false)); liveCount(); });
  $('#dlg-ok').addEventListener('click', () => { applied = draft(); render(); dlg.close(); });
  $('#dlg-x').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  $('#clear-all').addEventListener('click', () => {
    applied = { q: '', district: '', need: [], type: [], own: [] };
    qEl.value = ''; dEl.value = ''; setBoxes(applied); render();
  });
  render();
</script>
